backend:
  name: github
  repo: kcompanyra-ux/DASH
  branch: main
  base_url: https://auth.decapcms.org
  auth_scope: repo

site_url: https://kcompanyra-ux.github.io/Dash/

media_folder: "images/uploads"
public_folder: "/images/uploads"

collections:
  - name: site_config
    label: Site Configuration
    files:
      - name: general_settings
        label: General Settings
        file: content.json
        fields:
          - name: page_title
            label: Page Title
            widget: string
          - name: main_heading
            label: Main Heading
            widget: string
